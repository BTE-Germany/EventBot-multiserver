generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           BigInt    @id @db.BigInt
  banned       Boolean   @default(false)
  minecraft_id String    @unique @db.VarChar(255)
  points       Float     @default(0)
  team         String?   @db.VarChar(255)
  team_flag    String?   @db.VarChar(255)
  guild_id     String?   @db.VarChar(255)
  language     String    @default("en") @db.VarChar(10)
  boosters     Booster[]
}

model Build {
  id                Int      @id @default(autoincrement())
  message           BigInt?  @db.BigInt
  judge_msg         BigInt?  @db.BigInt
  location          String   @db.VarChar(255)
  A                 Float    @default(0)
  B                 Float    @default(0)
  base_points       Boolean  @default(true)
  foreign_build     Boolean  @default(false)
  builder_id        BigInt   @db.BigInt
  judges            Json
  images            Json
  created_timestamp DateTime @default(now()) @db.Timestamp(0)
  guild_id          String?  @db.VarChar(255)
}

model Booster {
  id          Int       @id @default(autoincrement())
  user_id     BigInt    @db.BigInt
  user        User      @relation(fields: [user_id], references: [id])
  type        String    @db.VarChar(50) // "points" or "multiplier"
  value       Float     // fixed points or multiplier value (e.g., 2.0 for 2x)
  duration    Int?      // duration in milliseconds (null for instant point boosters)
  activated   Boolean   @default(false)
  activated_at DateTime? @db.Timestamp(0)
  expires_at  DateTime? @db.Timestamp(0)
  created_at  DateTime  @default(now()) @db.Timestamp(0)
}
