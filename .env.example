# Only secrets and deployment details belong here.
# Everything else (servers, channels, events, teams, judges, image storage,
# webhook, legal texts, admins) is configured in the dashboard: run /dashboard in Discord.

BOT_TOKEN=
DATABASE_URL="postgresql://prisma:prisma@postgres:5432/db"

# Optional
PORT=6969
# Public address of the dashboard and API, used for login links and legal pages
PUBLIC_URL="http://localhost:6969"
# Bot owner, always an admin (default: 804386907244462141)
OWNER_ID=
# Secret of the Azure Blob Storage for screenshots (container + CDN URL are set in the dashboard)
AZURE_STORAGE_CONNECTION_STRING=
# Number of shards ("auto" or a number); each shard runs in its own worker thread
SHARDS=auto
# Size of the image/render worker pool
WORKER_THREADS=
LOG_LEVEL=info
